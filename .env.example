# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of this app. Must match the provider's authorised callback
# domain exactly when running against real credentials.
APP_URL=http://localhost:3000
# Signs the session cookie. At least 32 random characters.
SESSION_SECRET=replace-with-32-plus-random-chars
# SQLite file used by Prisma.
DATABASE_URL=file:./dev.db

# ---------------------------------------------------------------------------
# Mode switches
#
# Each integration is switched independently so they can be mixed, e.g. real
# WeChat login + mock WeChat Pay + mock Alipay. Any non-mock value makes the
# matching credentials below required at startup.
#
#   WeChat has no sandbox environment -> mock | live
#   Alipay has a sandbox environment  -> mock | sandbox | live
# ---------------------------------------------------------------------------
# WeChat login (Open Platform, website application).
WECHAT_LOGIN_MODE=mock
# WeChat Pay (API v3).
WECHAT_PAY_MODE=mock
# Alipay login (OAuth).
ALIPAY_LOGIN_MODE=mock
# Alipay PC website payment.
ALIPAY_PAY_MODE=mock

# ---------------------------------------------------------------------------
# WeChat login credentials (required when WECHAT_LOGIN_MODE != mock)
# ---------------------------------------------------------------------------
# Open Platform website application AppID.
WECHAT_APP_ID=
# Open Platform website application AppSecret.
WECHAT_APP_SECRET=

# ---------------------------------------------------------------------------
# WeChat Pay credentials (required when WECHAT_PAY_MODE != mock)
# ---------------------------------------------------------------------------
# Merchant ID.
WECHAT_PAY_MCH_ID=
# AppID bound to the merchant account.
WECHAT_PAY_APP_ID=
# API v3 key, exactly 32 characters, used to decrypt notification resources.
WECHAT_PAY_API_V3_KEY=
# Serial number of the merchant certificate.
WECHAT_PAY_CERT_SERIAL_NO=
# Path to the merchant private key (apiclient_key.pem).
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# Path to the WeChat Pay platform public key used to verify notifications.
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./certs/wechatpay_public_key.pem
# Notification endpoint WeChat calls on payment success.
WECHAT_PAY_NOTIFY_URL=${APP_URL}/api/pay/wechat/notify

# ---------------------------------------------------------------------------
# Alipay credentials
# Required when ALIPAY_LOGIN_MODE != mock or ALIPAY_PAY_MODE != mock.
# ---------------------------------------------------------------------------
# Alipay application ID.
ALIPAY_APP_ID=
# Application private key (RSA2), PKCS#8 or PKCS#1 PEM contents.
ALIPAY_PRIVATE_KEY=
# Alipay public key, used to verify asynchronous notifications.
ALIPAY_PUBLIC_KEY=
# Gateway endpoint. Sandbox: https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ---------------------------------------------------------------------------
# Alipay payment URLs (required when ALIPAY_PAY_MODE != mock)
# ---------------------------------------------------------------------------
# Notification endpoint Alipay calls on payment success.
ALIPAY_NOTIFY_URL=${APP_URL}/api/pay/alipay/notify
# Where Alipay sends the user's browser after payment.
ALIPAY_RETURN_URL=${APP_URL}/orders
